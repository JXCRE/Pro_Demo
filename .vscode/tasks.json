{
    "tasks": [
        {
            "type": "shell",
            "label": "CMake: 配置",
            "command": "cmake",
            "args": [
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "配置 CMake 项目，生成 Debug 构建"
        },
        {
            "type": "shell",
            "label": "CMake: 构建",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "CMake: 配置"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译所有源文件，生成可执行文件（自动先配置）"
        },
        {
            "type": "shell",
            "label": "CMake: 全部重新构建",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--clean-first",
                "--parallel"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "detail": "清理并重新编译整个项目"
        }
    ],
    "version": "2.0.0"
}